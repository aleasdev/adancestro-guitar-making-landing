---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuitarCard from '../../components/GuitarCard.astro';
import { getCollection } from 'astro:content';

const guitars = (await getCollection('guitars')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Guitarras" description="Galería de guitarras clásicas y flamencas artesanales.">
  <section class="pt-32 pb-20">
    <div class="container">
      <h1 class="font-heading text-4xl md:text-5xl text-cream">Guitarras</h1>
      <p class="mt-4 text-cream/50 text-lg max-w-2xl">
        Cada guitarra es una pieza única. Explora mi trabajo y descubre los detalles
        de cada construcción.
      </p>
      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {guitars.map((guitar) => <GuitarCard guitar={guitar} />)}
      </div>
    </div>
  </section>
</BaseLayout>
