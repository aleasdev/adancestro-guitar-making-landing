---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import GuitarCard from '../components/GuitarCard.astro';
import { getCollection } from 'astro:content';

const featuredGuitars = (await getCollection('guitars'))
  .filter((g) => g.data.featured)
  .slice(0, 3);
---

<BaseLayout title="Inicio" description="Luthería artesanal. Guitarras clásicas y flamencas hechas a mano por Adancestro.">
  <Hero
    title="Adancestro"
    subtitle="Guitarras clásicas y flamencas hechas a mano, con pasión"
    ctaText="Ver guitarras"
    ctaLink="/guitars"
    fullHeight
  />

  <section class="container py-20">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="font-heading text-3xl md:text-4xl text-cream">Guitarras destacadas</h2>
      <p class="mt-4 text-cream/50 text-lg font-light">
        Cada guitarra es única, construida con maderas seleccionadas y años de experiencia
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredGuitars.map((guitar) => <GuitarCard guitar={guitar} />)}
    </div>
    <div class="text-center mt-10">
      <a href="/guitars" class="inline-block px-8 py-3 border border-amber text-amber text-sm uppercase tracking-widest hover:bg-amber hover:text-charcoal transition-all">
        Ver todas
      </a>
    </div>
  </section>

  <section class="bg-white/5 py-20">
    <div class="container text-center max-w-3xl">
      <h2 class="font-heading text-3xl md:text-4xl text-cream">El arte de la luthería</h2>
      <p class="mt-6 text-cream/60 leading-relaxed text-lg font-light">
        Detrás de cada guitarra hay horas de dedicación, el canto de la gubia sobre la madera,
        el aroma del barniz y la emoción del primer acorde. Te invito a conocer mi taller
        y el proceso de creación de cada instrumento.
      </p>
      <a href="/workshop" class="inline-block mt-8 px-8 py-3 border border-amber text-amber text-sm uppercase tracking-widest hover:bg-amber hover:text-charcoal transition-all">
        Ver el taller
      </a>
    </div>
  </section>

  <section class="container py-20 text-center">
    <h2 class="font-heading text-3xl md:text-4xl text-cream">¿Quieres aprender?</h2>
    <p class="mt-4 text-cream/50 text-lg font-light max-w-xl mx-auto">
      Ofrezco cursos para quienes quieran construir su propia guitarra desde cero
    </p>
    <a href="/courses" class="inline-block mt-8 px-8 py-3 bg-amber text-charcoal font-semibold text-sm uppercase tracking-widest hover:bg-amber/90 transition-all">
        Ver cursos
      </a>
  </section>
</BaseLayout>
