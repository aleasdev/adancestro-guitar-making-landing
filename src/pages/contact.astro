---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getCollection, render } from 'astro:content';

const pages = await getCollection('pages');
const contactEntry = pages.find((p) => p.id === 'contact');
let Content;
let data;

if (contactEntry) {
  const rendered = await render(contactEntry);
  Content = rendered.Content;
  data = contactEntry.data;
}
---

<BaseLayout title={data?.title ?? 'Contacto'} description="Contacta con Lutheria Guitarras.">
  <section class="pt-32 pb-20">
    <div class="container max-w-3xl">
      <h1 class="font-heading text-4xl md:text-5xl text-cream">{data?.title ?? 'Contacto'}</h1>
      {Content && (
        <div class="mt-6 prose prose-invert prose-cream text-lg leading-relaxed">
          <Content />
        </div>
      )}
      <div class="mt-10">
        <h2 class="text-sm uppercase tracking-widest text-amber mb-6">Envíame un mensaje</h2>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
