---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('courses');
  return entries.map((e) => ({
    params: { slug: e.id },
    props: { entry: e },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<BaseLayout title={data.title} description={data.description} image={data.image}>
  <section class="pt-32 pb-20">
    <div class="container max-w-4xl">
      <a href="/courses" class="inline-flex items-center gap-2 text-cream/50 hover:text-amber text-sm transition-colors mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        Volver a cursos
      </a>

      <article>
        <h1 class="font-heading text-3xl md:text-4xl text-cream">{data.title}</h1>

        {data.image && (
          <img
            src={data.image}
            alt={data.title}
            class="mt-8 w-full aspect-video object-cover rounded-sm"
          />
        )}

        <p class="mt-8 text-cream/60 leading-relaxed text-lg">{data.description}</p>

        {(data.duration || data.price) && (
          <div class="mt-6 flex flex-wrap gap-6 text-sm">
            {data.duration && (
              <div class="flex items-center gap-2 text-cream/40">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {data.duration}
              </div>
            )}
            {data.price && (
              <div class="flex items-center gap-2 text-amber">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                {data.price}
              </div>
            )}
          </div>
        )}

        <div class="mt-10 prose prose-invert prose-cream max-w-none">
          <Content />
        </div>

        <div class="mt-12 pt-8 border-t border-white/5 text-center">
          <a href="/contact" class="inline-block px-8 py-3 bg-amber text-charcoal font-semibold text-sm uppercase tracking-widest hover:bg-amber/90 transition-all">
            Consultar disponibilidad
          </a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
