<form
  id="contact-form"
  class="space-y-6"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  name="contact"
  method="POST"
  action="/contact"
>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden">
    <label>No llenar si eres humano: <input name="bot-field" /></label>
  </p>

  <div>
    <label for="name" class="block text-sm text-cream/60 uppercase tracking-wider mb-2">Nombre</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      class="w-full px-4 py-3 bg-white/5 border border-white/10 text-cream rounded-sm focus:outline-none focus:border-amber transition-colors placeholder:text-cream/20"
      placeholder="Tu nombre"
    />
  </div>

  <div>
    <label for="email" class="block text-sm text-cream/60 uppercase tracking-wider mb-2">Email</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full px-4 py-3 bg-white/5 border border-white/10 text-cream rounded-sm focus:outline-none focus:border-amber transition-colors placeholder:text-cream/20"
      placeholder="tu@email.com"
    />
  </div>

  <div>
    <label for="message" class="block text-sm text-cream/60 uppercase tracking-wider mb-2">Mensaje</label>
    <textarea
      id="message"
      name="message"
      required
      rows="5"
      class="w-full px-4 py-3 bg-white/5 border border-white/10 text-cream rounded-sm focus:outline-none focus:border-amber transition-colors placeholder:text-cream/20 resize-none"
      placeholder="Escribe tu mensaje..."
    ></textarea>
  </div>

  <button
    type="submit"
    class="px-8 py-3 bg-amber text-charcoal font-semibold text-sm uppercase tracking-widest hover:bg-amber/90 transition-all disabled:opacity-50"
  >
    Enviar mensaje
  </button>
</form>
